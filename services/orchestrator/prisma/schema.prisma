generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  CREATED
  RUNNING
  IDLE
  TERMINATED
}

model Agent {
  id        String        @id @default(uuid())
  name      String
  status    AgentStatus   @default(CREATED)
  scopes    AgentScope[]
  policy    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  grants    PermissionGrant[]
  audits    AuditLog[]
}

model PermissionGrant {
  id        String   @id @default(uuid())
  agentId   String
  scopes    PermissionGrantScope[]
  action    String
  reason    String?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])
}

model AgentScope {
  id      String @id @default(uuid())
  agentId String
  scope   String
  agent   Agent  @relation(fields: [agentId], references: [id])

  @@unique([agentId, scope])
}

model PermissionGrantScope {
  id      String          @id @default(uuid())
  grantId String
  scope   String
  grant   PermissionGrant @relation(fields: [grantId], references: [id])

  @@unique([grantId, scope])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  agentId   String?
  details   Json?
  createdAt DateTime @default(now())
  agent     Agent?   @relation(fields: [agentId], references: [id])
}
